
@{ ViewData["Title"] = "FingerprintDeviceDemo"; }

<!--
本「综合演示」包含：自定义头部工具栏、获取表格数据、表格重载、自定义模板、单双行显示、单元格编辑、自定义底部分页栏、表格相关事件与操作、与其他组件的结合等相对常用的功能，以便快速掌握 table 组件的使用。
-->
<div style="padding: 16px;margin: 0 auto;width: 1024px">
    
    <table class="layui-hide" id="test" lay-filter="test"></table>
    <style>
        button {
            width: 160px;
        }
    </style>
    <div class="layui-btn-container" style="margin: 10px 0">
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="collectList_emp_modal_btn">getUserList</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="collectInfo_emp_modal_btn">getUserInfo</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="setUserToDevice_emp_modal_btn">SetUserToDevice</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="setUserName_modal_btn">setUserNameToDevice</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="initSys_emp_modal_btn">InitSystem</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="logInfo_emp_modal_btn">LogRecord</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="accessWeek_emp_modal_btn">SetAccessWeek</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="accessDay_emp_modal_btn">SetAccessDay</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="lockGroup_emp_modal_btn">SetLockGroup</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="authorize_emp_modal_btn">Authorize</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="download_emp_modal_btn">downloadSelectMessage</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="getDeviceInfo_modal_btn">getDeviceInfo</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="openDoor_modal_btn">openDoor</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="addUser_modal_btn">Add user</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="getDevLock_modal_btn">getDevLock</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="getUserLock_modal_btn">getUserLock</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="cleanAdmin_modal_btn">cleanAdmin</button>
        <button class="layui-btn layui-btn-sm layui-bg-blue" id="synchronize_Time">SynchronizeTime</button>
    </div>
</div>
