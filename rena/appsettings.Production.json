{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": "/tmp/logs/app-log-.txt",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 7,
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};Timeout=30;"
  },
  "SocketServer": {
    "Port": 8080
  },
  "ImagePath": {
    "Url": "/app/wwwroot/images/tmp"
  }
}
